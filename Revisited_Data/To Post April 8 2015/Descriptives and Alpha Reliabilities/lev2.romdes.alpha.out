INPUT INSTRUCTIONS

   TITLE: Level 2 Romantic Desire Alpha Reliability

     DATA:
    FILE IS
  speed.dating.mplus.10.dat;

    VARIABLE: NAMES ARE Part_num MatchID_clean Follow_clean
    IRLikedPartner IRSayYes IRSexAttract
      IRThinkCareer IRThinkAmbitious IRThinkPhys
      IRThinkHot IRThinkFun IRThinkResponsive
      IRThinkDependable IRThinkFriendly IRCommon
      IRPersonality IRConnection yessing mutmatch PMexcited
      PMSelfinit PMMatchinit FUEager FUInitiate FUEnjoy
      FUSexDesire FUSoulMate FURomInterest FUOnlyWith
      FUMind FUOneNight FUCasual FUSerious FUCommitted
      FUExtentPhys FUExtentCareer FUExtentAmbitious
      FUExtentHot FUExtentFun FUExtentRespons
      FUExtentFriendly DemAge DemEthn FUPhysContact
      FUInitiatePhys FUEnjoyContact FUContactBad
      IRpatt IRepro IRpers IRrdes IRchem FUpasn FUpatt FUepro
      FUpers FUStatus sex_M1_F2;

      CLUSTER =Part_num;

  USEVARIABLES ARE Part_num IRLikedPartner IRSayYes IRSexAttract ;

   USEOBS Follow_clean EQ 1;

  CLUSTER = Part_num;
  MISSING ARE ALL (-999);

   ANALYSIS:
  TYPE=TWOLEVEL;

  MODEL:

  MODEL:
  %WITHIN%

  IRLikedPartner WITH
  IRSayYes (WC1)
  IRSexAttract (WC2);

  IRSayYes WITH
  IRSexAttract (WC3);

  IRLikedPartner (WV1);
  IRSayYes (WV2);
  IRSexAttract (WV3);



  %BETWEEN%
  IRLikedPartner WITH
  IRSayYes (BC1)
  IRSexAttract (BC2);

  IRSayYes WITH
  IRSexAttract (BC3);

  IRLikedPartner (BV1);
  IRSayYes (BV2);
  IRSexAttract (BV3);



  OUTPUT: SAMPSTAT STDYX;

  MODEL CONSTRAINT: NEW(COMP_V_W ALPHAW COMP_V_B ALPHAB);

  COMP_V_W = WV1+WV2+WV3+2*(WC1+WC2+WC3);

  ALPHAW = (((WC1+WC2+WC3)/3)*9)/COMP_V_W;

  COMP_V_B = BV1+BV2+BV3+2*(BC1+BC2+BC3);

  ALPHAB = (((BC1+BC2+BC3)/3)*9)/COMP_V_B;






