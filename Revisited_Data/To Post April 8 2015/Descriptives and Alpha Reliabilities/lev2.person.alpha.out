Mplus VERSION 7.11
MUTHEN & MUTHEN
07/23/2014   3:10 PM

INPUT INSTRUCTIONS

   TITLE: Level 2 Personable Alpha Reliability

     DATA:
    FILE IS
  speed.dating.mplus.10.dat;

    VARIABLE: NAMES ARE Part_num MatchID_clean Follow_clean
    IRLikedPartner IRSayYes IRSexAttract
      IRThinkCareer IRThinkAmbitious IRThinkPhys
      IRThinkHot IRThinkFun IRThinkResponsive
      IRThinkDependable IRThinkFriendly IRCommon
      IRPersonality IRConnection yessing mutmatch PMexcited
      PMSelfinit PMMatchinit FUEager FUInitiate FUEnjoy
      FUSexDesire FUSoulMate FURomInterest FUOnlyWith
      FUMind FUOneNight FUCasual FUSerious FUCommitted
      FUExtentPhys FUExtentCareer FUExtentAmbitious
      FUExtentHot FUExtentFun FUExtentRespons
      FUExtentFriendly DemAge DemEthn FUPhysContact
      FUInitiatePhys FUEnjoyContact FUContactBad
      IRpatt IRepro IRpers IRrdes IRchem FUpasn FUpatt FUepro
      FUpers FUStatus sex_M1_F2;

      CLUSTER =Part_num;

  USEVARIABLES ARE Part_num IRThinkFun IRThinkResponsive
      IRThinkDependable IRThinkFriendly ;

   USEOBS Follow_clean EQ 1;

  CLUSTER = Part_num;
  MISSING ARE ALL (-999);

   ANALYSIS:
  TYPE=TWOLEVEL;

  MODEL:
  %WITHIN%

  IRTHINKFUN WITH
  IRTHINKRESPONSIVE (WC1)
  IRTHINKDEPENDABLE (WC2)
  IRTHINKFRIENDLY (WC3);

  IRTHINKRESPONSIVE WITH
  IRTHINKDEPENDABLE (WC4)
  IRTHINKFRIENDLY (WC5);

  IRTHINKDEPENDABLE WITH IRTHINKFRIENDLY (WC6);

  IRTHINKFUN (WV1);
  IRTHINKRESPONSIVE (WV2);
  IRTHINKDEPENDABLE (WV3);
  IRTHINKFRIENDLY (WV4);



  %BETWEEN%
  IRTHINKFUN WITH
  IRTHINKRESPONSIVE (BC1)
  IRTHINKDEPENDABLE (BC2)
  IRTHINKFRIENDLY (BC3);

  IRTHINKRESPONSIVE WITH
  IRTHINKDEPENDABLE (BC4)
  IRTHINKFRIENDLY (BC5);

  IRTHINKDEPENDABLE WITH IRTHINKFRIENDLY (BC6);

  IRTHINKFUN (BV1);
  IRTHINKRESPONSIVE (BV2);
  IRTHINKDEPENDABLE (BV3);
  IRTHINKFRIENDLY (BV4);



  OUTPUT: SAMPSTAT STDYX;

  MODEL CONSTRAINT: NEW(COMP_V_W ALPHAW COMP_V_B ALPHAB);

  COMP_V_W = WV1+WV2+WV3+WV4+2*(WC1+WC2+WC3+WC4+
  WC5+WC6);

  ALPHAW = (((WC1+WC2+WC3+WC4+
  WC5+WC6)/6)*16)/COMP_V_W;

  COMP_V_B = BV1+BV2+BV3+BV4+2*(BC1+BC2+BC3+BC4+
  BC5+BC6);

  ALPHAB = (((BC1+BC2+BC3+BC4+
  BC5+BC6)/6)*16)/COMP_V_B;






